{
  // =============================================================================
  // SenacGames.Desktop - appsettings.json
  // =============================================================================
  //  CONCEITO: Arquivo de configuração da aplicação Desktop.
  //
  // Em DESENVOLVIMENTO, a URL da API é descoberta AUTOMATICAMENTE pelo
  // ApiEndpointResolver, que lê o launchSettings.json do projeto SenacGames.API.
  // Você NÃO precisa alterar este arquivo durante o desenvolvimento.
  //
  // Este arquivo serve como FALLBACK (Prioridade 2) caso o launchSettings
  // não seja encontrado (ex: produção, CI/CD, máquina sem o código fonte da API).
  //
  // ====================================================
  // COMO ALTERAR A URL DA API MANUALMENTE
  // ====================================================
  //
  // 1. Desenvolvimento (opcional — normalmente automático):
  //    Altere "ApiSettings.BaseUrl" abaixo para a URL desejada.
  //    O ApiEndpointResolver usará o launchSettings ANTES de ler este arquivo.
  //
  // 2. Produção:
  //    Defina "ApiSettings.BaseUrl" com a URL de produção:
  //    "https://api.senacgames.com"
  //    Em produção, o launchSettings não existirá, então este valor será usado.
  //
  // ====================================================
  // ESCOPO DE CADA CAMPO
  // ====================================================
  //
  // ApiSettings.BaseUrl   URL base da API (Prioridade 2 — fallback)
  // AppSettings.AppName   Nome exibido no título da janela
  // AppSettings.Version   Versão exibida no rodapé
  // AppSettings.Timeout   Timeout das requisições HTTP (em segundos)
  // =============================================================================
  "ApiSettings": {
    "BaseUrl": "http://localhost:5223"
  },
  "AppSettings": {
    "AppName": "SenacGames Desktop",
    "Version": "1.0.0",
    "Timeout": 30
  }
}
